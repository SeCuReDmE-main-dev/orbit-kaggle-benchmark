# @CONTRACT@

import re, uuid
from contextvars import ContextVar
CAMPAIGN_ID = 'orbit-native-pass-fail-hardening-20261008-v1'
DIAGNOSTIC_DIR = Path('/kaggle/working/orbit-native-pass-fail-hardened')
_ATTEMPT_CAPTURE = ContextVar('orbit_hardened_attempt_capture', default=None)


class DiagnosticPersistenceError(RuntimeError):
    """A computed observation exists, but its detailed receipt was not saved."""
    def __init__(self, report, cause):
        super().__init__('DIAGNOSTIC_PERSISTENCE_ERROR')
        self.phase = 'diagnostics'
        self.computedResult = report.get('result')
        self.computedOutcome = report['outcome']
        self.diagnosticErrorType = type(cause).__name__
        self.retryEligible = False


class AggregateDiagnosticPersistenceError(RuntimeError):
    """Keep already computed model observations if their aggregate cannot be saved."""
    def __init__(self, observations, cause):
        super().__init__('AGGREGATE_DIAGNOSTIC_PERSISTENCE_ERROR')
        self.phase = 'diagnostics'
        self.computedObservations = [dict(observation) for observation in observations]
        self.diagnosticErrorType = type(cause).__name__
        self.retryEligible = False


def _prompt_once(llm, report):
    report['providerAttempts'] = 1
    try:
        return llm.prompt(PROMPT)
    except Exception as error:
        report['technicalAttempts'].append({'attempt': 1, 'errorType': type(error).__name__,
                                           'httpStatus': getattr(error, 'status_code', None)})
        raise


def _write_json_atomic(target, value):
    # ASCII escaping safely preserves even a JSON-escaped lone surrogate.
    payload = json.dumps(value, indent=2, ensure_ascii=True) + '\n'
    target.parent.mkdir(exist_ok=True)
    temporary = target.with_suffix('.json.tmp')
    try:
        with temporary.open('w', encoding='utf-8', newline='\n') as stream:
            stream.write(payload)
        temporary.replace(target)
    finally:
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass


def _save_diagnostics(report):
    model = re.sub(r'[^a-zA-Z0-9_-]', '-', report['model'])[:80]
    target = DIAGNOSTIC_DIR / (model + '-' + report['observationId'] + '.json')
    _write_json_atomic(target, report)


def _save_model_observations(observations):
    try:
        _write_json_atomic(DIAGNOSTIC_DIR / 'model-observations.json', observations)
    except Exception as error:
        event = {'campaignId': CAMPAIGN_ID, 'phase': 'diagnostics',
                 'receipt': 'model-observations.json', 'errorType': type(error).__name__,
                 'observationCount': len(observations), 'retryEligible': False}
        try:
            print(json.dumps(event, ensure_ascii=True), file=sys.stderr)
        except Exception:
            pass
        raise AggregateDiagnosticPersistenceError(observations, error) from error


def _report_diagnostic_failure(report, error):
    event = {'campaignId': CAMPAIGN_ID, 'observationId': report['observationId'],
             'phase': 'diagnostics', 'errorType': type(error).__name__,
             'computedResult': report.get('result'), 'computedOutcome': report['outcome'],
             'providerAttempts': report['providerAttempts'], 'retryEligible': False}
    try:
        print(json.dumps(event, ensure_ascii=True), file=sys.stderr)
    except Exception:
        pass  # A broken diagnostic sink must never replace the original error.


@kbench.task(name='Orbit hardened native pass/fail',description='Strict six-question synthetic scope pilot. Boolean pass requires complete valid output, exact passages and all three engine checks.',version=1)
def orbit_native_pass_fail_hardened(llm) -> bool:
    report={'campaignId':CAMPAIGN_ID,'observationId':uuid.uuid4().hex,'model':str(getattr(llm,'name','unknown')),'promptSha256':hashlib.sha256(PROMPT.encode()).hexdigest(),'engineSha256':ENGINE_SHA256,'nodeVersion':node_version,'nodeSource':NODE_SOURCE,'providerAttempts':0,'technicalAttempts':[],'checks':[],'outcome':'technical-error','result':None}
    primary_error = None
    def check(ok,name):
        passed=bool(ok)
        report['checks'].append({'name':name,'passed':passed})
        kbench.assertions.assert_true(passed,expectation=name)
        return passed
    try:
        report['technicalPhase']='provider'
        raw=_prompt_once(llm,report)
        report['technicalPhase']='validation'
        try:
            answer=parse_answer(raw)
        except InvalidModelOutput as error:
            check(False,'Valid complete JSON model output: '+str(error))
            report['outcome']='invalid-model-output';report['result']=False
            return False
        validation=validate_answer(answer,PUBLIC,GOLD)
        for item in validation['checks']:check(item['passed'],item['name'])
        report['modelAnswer']=answer
        if not validation['valid']:
            report['outcome']=validation['outcome'];report['result']=False
            return False
        docs={d['id']:d for d in PUBLIC['documents']};qs={q['id']:q for q in PUBLIC['questions']}
        requests=[];metadata=[]
        for row in answer['results']:
            q=qs[row['questionId']]
            dossier={'format':'orbit-evidence-v1','id':q['id'],'title':'Synthetic native Boolean pilot','question':q['statement'],'objective':'','context':'','revision':0,'createdAt':'2026-09-29T00:00:00.000Z','updatedAt':'2026-09-29T00:00:00.000Z','axes':[], 'sources':[{'id':x['id'],'title':x['id'],'url':'https://example.org/orbit-pilot/'+x['id'],'status':'read','text':x['text'],'contentHash':hashlib.sha256(x['text'].encode()).hexdigest()} for x in docs.values()], 'claims':[{'id':q['id'],'statement':q['statement'],'kind':'reported','disposition':'indeterminate','scopeAttributes':q['scope'],'evidence':row['evidence']}],'screeningCriteria':[],'sourceDecisions':[],'extractions':[],'knowledgeReads':[],'answer':'','report':'','proposals':[],'reviews':[],'history':[],'example':True}
            for engine in ('baseline','n','p'):
                requests.append({'dossier':dossier,'engine':engine});metadata.append((q['id'],engine))
        report['technicalPhase']='engine'
        process=subprocess.run([NODE,str(ENGINE_PATH)],input=''.join(json.dumps(x)+'\n' for x in requests),capture_output=True,text=True,timeout=60)
        if process.returncode:raise RuntimeError('SHARED_ENGINE_PROCESS_ERROR')
        try:calculated=[json.loads(line) for line in process.stdout.splitlines() if line.strip()]
        except (ValueError,RecursionError) as error:raise RuntimeError('SHARED_ENGINE_TRANSPORT_INVALID_JSON') from error
        if len(calculated)!=18:raise RuntimeError('SHARED_ENGINE_INCOMPLETE_OUTPUT')
        check(len(calculated)==len(metadata),'Engine returned all eighteen evaluations')
        evaluations=[]
        for (qid,engine),item in zip(metadata,calculated):
            if not isinstance(item,dict) or type(item.get('ok')) is not bool:raise RuntimeError('SHARED_ENGINE_PROTOCOL_ERROR')
            if not item['ok']:
                report['engineEvaluations']=evaluations+[{'questionId':qid,'engine':engine,**item}]
                raise RuntimeError('SHARED_ENGINE_REJECTED_VALIDATED_INPUT')
            check(item['ok'],'Portable evidence schema accepted '+engine+'/'+qid)
            if item['ok']:
                results=item.get('result')
                if not isinstance(results,list) or len(results)!=1 or not isinstance(results[0],dict) or results[0].get('claimId')!=qid:raise RuntimeError('SHARED_ENGINE_RESULT_IDENTITY_ERROR')
                decision=results[0].get('decision')
                if decision not in ('ADMIT','REJECT','HOLD'):raise RuntimeError('SHARED_ENGINE_DECISION_PROTOCOL_ERROR')
                check(decision==GOLD[qid],'Shared engine decision matches reference '+engine+'/'+qid)
            evaluations.append({'questionId':qid,'engine':engine,**item})
        report['engineEvaluations']=evaluations
        passed=bool(report['checks']) and all(item['passed'] for item in report['checks'])
        kbench.assertions.assert_equal(True,passed,expectation='Entire strict pilot passes only when every check passes')
        report['result']=bool(passed);report['outcome']='pass' if passed else 'contract-fail'
        return bool(passed)
    except Exception as error:
        primary_error = error
        report['outcome']='technical-error';report['technicalErrorType']=type(error).__name__
        capture = _ATTEMPT_CAPTURE.get()
        if capture is not None:
            capture.update({'state': 'technical-error', 'result': None,
                'errorType': type(error).__name__, 'technicalPhase': report['technicalPhase'],
                'observationId': report['observationId'],
                'providerAttempts': report['providerAttempts'], 'retryEligible': False})
        raise
    finally:
        try:
            _save_diagnostics(report)
        except Exception as diagnostic_error:
            _report_diagnostic_failure(report, diagnostic_error)
            if primary_error is None:
                # SDK 0.6.1 can swallow root-run exceptions and return FAILED.
                # Capture only this attempt's categorical result before it does.
                capture = _ATTEMPT_CAPTURE.get()
                if capture is not None:
                    capture.update({'state': 'technical-error', 'result': None,
                        'errorType': 'DiagnosticPersistenceError', 'technicalPhase': 'diagnostics',
                        'observationId': report['observationId'],
                        'computedResult': report.get('result'), 'computedOutcome': report['outcome'],
                        'diagnosticErrorType': type(diagnostic_error).__name__, 'retryEligible': False})
                raise DiagnosticPersistenceError(report, diagnostic_error) from diagnostic_error
            # Keep the original provider/process exception and its traceback.

# %%
# One authorized attempt per exact model; this preparation dispatches none.
def run_planned_models():
    observations = []
    for model_id in SELECTED_MODELS:
        capture = {}
        token = _ATTEMPT_CAPTURE.set(capture)
        try:
            run = orbit_native_pass_fail_hardened.run(kbench.llms[model_id])
            value = getattr(run, 'result', None)
            observation = {'model': model_id,
                'state': 'completed' if type(value) is bool else 'native-result-needs-inspection',
                'result': value if type(value) is bool else None,
                'nativeResultType': type(value).__name__}
        except Exception as error:
            observation = {'model': model_id, 'state': 'technical-error', 'result': None,
                           'errorType': type(error).__name__}
            if isinstance(error, DiagnosticPersistenceError):
                observation.update({'technicalPhase': error.phase,
                    'computedResult': error.computedResult, 'computedOutcome': error.computedOutcome,
                    'retryEligible': False})
            # Keep the observation; try the other planned model once, never retry this one.
        finally:
            _ATTEMPT_CAPTURE.reset(token)
        observation.update(capture)
        observations.append(observation)
    return observations

MODEL_OBSERVATIONS = []
if RUN_MODELS:
    MODEL_OBSERVATIONS = run_planned_models()
    _save_model_observations(MODEL_OBSERVATIONS)
    print(json.dumps(MODEL_OBSERVATIONS, ensure_ascii=True))
else:
    print('Prepared only: zero model dispatches. RUN_MODELS is False.')

# %%
if RUN_MODELS:
    # Preserve native SDK artifacts BEFORE the official main-task selector prunes them.
    # These runtime copies can contain native chats; inspect before any public export.
    NATIVE_ARCHIVE=DIAGNOSTIC_DIR/'native-artifacts'
    NATIVE_ARCHIVE.mkdir(exist_ok=True)
    artifacts=sorted(set(Path('/kaggle/working').glob('*run.json'))|set(Path('/kaggle/working').glob('*task.json')))
    if len(artifacts)>100 or sum(p.stat().st_size for p in artifacts)>64*1024*1024:
        raise RuntimeError('NATIVE_ARTIFACT_ARCHIVE_BOUND_EXCEEDED')
    for artifact in artifacts:
        if artifact.is_symlink() or not artifact.is_file():raise RuntimeError('UNSAFE_NATIVE_ARTIFACT')
        shutil.copy2(artifact,NATIVE_ARCHIVE/artifact.name)
    print(json.dumps({'nativeArtifactsPreserved':len(artifacts),'archive':str(NATIVE_ARCHIVE)}))
    get_ipython().run_line_magic('choose','orbit_native_pass_fail_hardened')
else:
    print('Prepared only: native archive and task selection skipped.')
