import sys, shutil, json, importlib.metadata
from pathlib import Path
if not Path('/kaggle/working').is_dir():
    raise RuntimeError('KAGGLE_RUNTIME_REQUIRED')
import kaggle_benchmarks as kbench
SDK_VERSION=importlib.metadata.version('kaggle-benchmarks')
if SDK_VERSION!='0.6.1':
    raise RuntimeError('SDK_IDENTITY_MISMATCH: expected kaggle-benchmarks 0.6.1')
SELECTED_MODELS=['google/gemini-3.8-flash','google/gemini-3.1-pro-preview']
if any(model not in kbench.llms for model in SELECTED_MODELS):
    raise RuntimeError('PINNED_MODEL_UNAVAILABLE: native Benchmark Task mode and catalog required')
print(json.dumps({'python':sys.version,'sdk':SDK_VERSION,'models':SELECTED_MODELS,'modelCalls':0}))
RUN_MODELS = False  # Change only after a separately authorized free-quota check.

